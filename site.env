# site.env
# Environment variable glossary for Handles Public API.
# This file documents expected variables and defaults.
# Do not put real secrets in this file.

############################
# Core API Runtime
############################
# Required: no
# Default: development when unset in app constructor fallback behavior
# Example: NODE_ENV=production
NODE_ENV=

# Required: no
# Default: false
# Notes: Used by shared Kora Labs libs to force "local" runtime assumptions.
# Example: IS_LOCAL=true
IS_LOCAL=

# Required: no
# Default: empty
# Notes: Used by shared Kora Labs libs (and some AWS deployments) to select region-scoped values.
# Example: AWS_REGION=us-east-1
AWS_REGION=

# Required: no
# Default: 3141
# Example: PORT=3141
PORT=

# Required: no
# Default: mainnet in most run scripts
# Example: NETWORK=preview
NETWORK=

# Required: no
# Default: http://localhost:1337
# Example: OGMIOS_HOST=http://0.0.0.0:1337
OGMIOS_HOST=

# Required: no
# Default: false
# Example: READ_ONLY_STORE=true
READ_ONLY_STORE=

# Required: no
# Default: false
# Example: USE_LAMBDA_SCANNER=true
USE_LAMBDA_SCANNER=

# Required: no
# Default: false
# Example: DISABLE_HANDLES_SNAPSHOT=true
DISABLE_HANDLES_SNAPSHOT=

# Required: no
# Default: set internally by app.ts
# Example: INDEX_SCHEMA_VERSION=1
INDEX_SCHEMA_VERSION=

# Required: no
# Default: set internally by app.ts
# Example: UTXO_SCHEMA_VERSION=1
UTXO_SCHEMA_VERSION=

############################
# HTTP / API Features
############################
# Required: no
# Default: false
# Example: CREDENTIALS=true
CREDENTIALS=

# Required: no
# Default: empty string
# Example: CORS_ORIGIN=https://app.handle.me
CORS_ORIGIN=

# Required: no
# Default: false
# Example: ENABLE_DATUM_ENDPOINT=true
ENABLE_DATUM_ENDPOINT=

# Required: no
# Default: false
# Example: RATE_LIMITER_ENABLED=true
RATE_LIMITER_ENABLED=

# Required: no
# Default: empty string (comma-separated values)
# Example: WHITELISTED_API_KEYS=abc123,def456
WHITELISTED_API_KEYS=

############################
# Dynamic Loading / App Extensions
############################
# Required: no
# Default: only project root dynamic dirs
# Example: DYNAMIC_LOAD_DIR=../custom-api
DYNAMIC_LOAD_DIR=

############################
# IPFS / Metadata Resolution
############################
# Required: no
# Default: https://ipfs.io/ipfs/
# Example: IPFS_GATEWAY=https://public-handles.myfilebase.com/ipfs/
IPFS_GATEWAY=

# Required: no
# Default: https://ipfs.io/ipfs/
# Example: IPFS_GATEWAY_BACKUP=https://public-handles.mypinata.cloud/ipfs/
IPFS_GATEWAY_BACKUP=

# Required: no
# Default: empty
# Example: PINATA_GATEWAY_TOKEN=your_token_here
PINATA_GATEWAY_TOKEN=

############################
# Provider Credentials
############################
# Required: recommended for scanner/snapshot utilities
# Default: empty
# Example: BLOCKFROST_API_KEY=mainnet...
BLOCKFROST_API_KEY=

# Required: recommended for Koios-based fetch helpers
# Default: empty
# Example: KOIOS_API_BEARER_TOKEN=eyJ...
KOIOS_API_BEARER_TOKEN=

############################
# Valkey / Redis Worker
############################
# Required: no
# Default: 127.0.0.1
# Notes: Resolved by `@koralabs/kora-labs-common` as:
#   `REDIS_HOST_${AWS_REGION}` (uppercased, dashes -> underscores) then `REDIS_HOST` then fallback.
#   Also used by `shell/local_valkey.sh` (default there is `127.0.0.1` when unset).
# Example: REDIS_HOST=valkey
REDIS_HOST=

# Required: no
# Default: empty
# Notes: Region-scoped override when `AWS_REGION` is set (example key for us-east-1 is `REDIS_HOST_US_EAST_1`).
# Example: REDIS_HOST_US_EAST_1=valkey.us-east-1.internal
REDIS_HOST_US_EAST_1=

# Required: no
# Default: true in worker when unset
# Example: REDIS_USE_TLS=false
REDIS_USE_TLS=

# Required: no
# Default: 6379 in worker, 6380 in `shell/local_valkey.sh`
# Notes: Port used by the Valkey worker (`workers/redisSync.worker.js`) and local test helper.
# Example: REDIS_PORT=6380
REDIS_PORT=

############################
# Container / Entrypoint Runtime
############################
# Required: no
# Default: all
# Values: api-only | ogmios | cardano-node | both | all
# Example: MODE=all
MODE=

# Required: no
# Default: false
# Example: DISABLE_NODE_SNAPSHOT=true
DISABLE_NODE_SNAPSHOT=

# Required: no
# Default: /db
# Example: NODE_DB=/mnt/efs/cardano/mainnet/db
NODE_DB=

# Required: no
# Default: /ipc/node.socket
# Example: SOCKET_PATH=/ipc/node.socket
SOCKET_PATH=

# Required: no
# Default: ./cardano-node
# Example: CARDANO_NODE_PATH=./cardano-node
CARDANO_NODE_PATH=

# Required: no
# Default: ./${NETWORK}
# Example: NODE_CONFIG_PATH=./mainnet
NODE_CONFIG_PATH=

# Required: no
# Default: false
# Example: ENABLE_SOCKET_REDIRECT=true
ENABLE_SOCKET_REDIRECT=

# Required: no
# Default: https://book.world.dev.cardano.org/environments
# Example: CONFIG_FILES_BASE_URL=https://book.world.dev.cardano.org/environments
CONFIG_FILES_BASE_URL=

############################
# Local Dev / Script Utilities
############################
# Required: no
# Default: from helper scripts
# Example: CARDANO_DB_PATH=./tmp
CARDANO_DB_PATH=

# Required: no
# Default: empty
# Notes: Used by local scripts that compare local results to live `api.handle.me`.
# Example: HANDLES_API_KEY=your_whitelisted_key
HANDLES_API_KEY=

# Required: no
# Default: from helper scripts
# Example: LAMBDA_DOWNLOAD_URL=https://...lambda-url.../get-file
LAMBDA_DOWNLOAD_URL=

# Required: no
# Default: inherited from Node
# Example: NODE_OPTIONS=--max-old-space-size=12288
NODE_OPTIONS=

# Optional legacy/common runtime values currently exported but not directly consumed
SECRET_KEY=
LOG_FORMAT=
LOG_DIR=
