# site.env
# Environment variable glossary for Handles Public API.
# This file documents expected variables and defaults.
# Do not put real secrets in this file.
#
# Each section is tagged with its consumer scope:
#   [APP]       — read by the TypeScript app at runtime (Express + Lambda)
#   [CONTAINER] — read only by shell/entrypoint.sh and shell/install.sh
#   [SCRIPT]    — read only by ad-hoc utilities under scripts/

############################
# [APP] Core API Runtime
############################
# Required: no
# Default: development when unset in app constructor fallback behavior
# Example: NODE_ENV=production
NODE_ENV=

# Required: no
# Default: false
# Notes: Used by shared Kora Labs libs to force "local" runtime assumptions.
# Example: IS_LOCAL=true
IS_LOCAL=

# Required: no
# Default: empty
# Notes: Used by shared Kora Labs libs (and some AWS deployments) to select region-scoped values.
# Example: AWS_REGION=us-east-1
AWS_REGION=

# Required: no
# Default: 3141
# Example: PORT=3141
PORT=

# Required: no
# Default: mainnet in most run scripts
# Example: NETWORK=preview
NETWORK=

# Required: no
# Default: http://localhost:1337
# Example: OGMIOS_HOST=http://0.0.0.0:1337
OGMIOS_HOST=

# Required: no
# Default: true
# Notes: Set to false to disable Ogmios scanning (read-only API mode).
# Example: ENABLE_OGMIOS_SCANNING=false
ENABLE_OGMIOS_SCANNING=

# Required: no
# Default: false
# Example: USE_LAMBDA_SCANNER=true
USE_LAMBDA_SCANNER=

# Required: no
# Default: false
# Example: DISABLE_HANDLES_SNAPSHOT=true
DISABLE_HANDLES_SNAPSHOT=

# Required: no
# Default: set internally by app.ts
# Example: INDEX_SCHEMA_VERSION=1
INDEX_SCHEMA_VERSION=

# Required: no
# Default: set internally by app.ts
# Example: UTXO_SCHEMA_VERSION=1
UTXO_SCHEMA_VERSION=

############################
# [APP] HTTP / API Features
############################
# Required: no
# Default: false
# Example: CREDENTIALS=true
CREDENTIALS=

# Required: no
# Default: empty string
# Notes: `ORIGIN` takes precedence over `CORS_ORIGIN` when both are set (config reads both, ORIGIN wins).
# Example: CORS_ORIGIN=https://app.handle.me
CORS_ORIGIN=

# Required: no
# Default: empty string
# Notes: Alternate alias for CORS_ORIGIN. If set, overrides CORS_ORIGIN.
# Example: ORIGIN=https://app.handle.me
ORIGIN=

# Required: no
# Default: false
# Notes: Only gates deprecated `GET /handles/:handle/datum`. `POST /datum` is always routed.
# Example: ENABLE_DATUM_ENDPOINT=true
ENABLE_DATUM_ENDPOINT=

# Required: no
# Default: false
# Example: RATE_LIMITER_ENABLED=true
RATE_LIMITER_ENABLED=

# Required: no
# Default: empty string (comma-separated values)
# Notes: Used by API rate limiter bypass
# Example: WHITELISTED_API_KEYS=abc123,def456
WHITELISTED_API_KEYS=

############################
# [APP] Dynamic Loading / App Extensions
############################
# Required: no
# Default: only project root dynamic dirs
# Example: DYNAMIC_LOAD_DIR=../custom-api
DYNAMIC_LOAD_DIR=

############################
# [APP] IPFS / Metadata Resolution
############################
# Required: no
# Default: https://ipfs.io/ipfs/
# Example: IPFS_GATEWAY=https://public-handles.myfilebase.com/ipfs/
IPFS_GATEWAY=

# Required: no
# Default: https://ipfs.io/ipfs/
# Example: IPFS_GATEWAY_BACKUP=https://public-handles.mypinata.cloud/ipfs/
IPFS_GATEWAY_BACKUP=

# Required: no
# Default: empty
# Example: PINATA_GATEWAY_TOKEN=your_token_here
PINATA_GATEWAY_TOKEN=

############################
# [APP] Provider Credentials
############################
# Required: recommended for Blockfrost-backed helpers
# Default: empty
# Notes: snapshot verification now reads the indexed `handle_root@handle_settings` datum directly instead of requiring Blockfrost.
# Example: BLOCKFROST_API_KEY=mainnet...
BLOCKFROST_API_KEY=

# Required: recommended for Koios-based fetch helpers
# Default: empty
# Example: KOIOS_API_BEARER_TOKEN=eyJ...
KOIOS_API_BEARER_TOKEN=

# Optional: Maestro API key (mainnet free tier today)
# Notes: When set, the scanner uses Maestro's policy-tx endpoint to discover handle-touching
# tx_hashes per scan window in one cheap call, replacing the bulk block_txs+filter work.
# When unset, the scanner falls back to the existing Koios block_txs + tx_info filter path
# transparently (same correctness, slower). Free tier is 33,333 calls/day at 10 RPS.
# Default: empty (Maestro disabled, current path used)
# Example: MAESTRO_API_KEY=...
MAESTRO_API_KEY=

# Optional: ceiling on requests/second to Maestro (per the free-tier 10 RPS limit).
# Default: 8
MAESTRO_HIGH_RPS=

# Optional: cool-down (seconds) applied after a 429 from Maestro before the scanner
# attempts it again. Honored across invocations via Redis. If Maestro returns a Retry-After
# header, that value wins over this default.
# Default: 60
MAESTRO_DEFAULT_COOLDOWN_SECONDS=

# Optional: when Maestro reports daily credits remaining at or below this threshold
# (via X-Maestro-Credits-Remaining response header), the scanner proactively engages
# the long cool-down below — better than waiting to be 429'd at the per-day limit.
# Free tier is 33,333/day; default 200 leaves a small buffer for the day's remainder.
# Default: 200
MAESTRO_LOW_CREDITS_THRESHOLD=

# Optional: cool-down (seconds) applied when daily credits drop below the threshold above.
# Long enough that we don't keep banging the API for the rest of the quota day; short
# enough that we recover automatically after the daily reset.
# Default: 3600  (1 hour)
MAESTRO_LOW_CREDITS_COOLDOWN_SECONDS=

############################
# [APP] Valkey / Redis Worker
############################
# Required: no
# Default: 127.0.0.1
# Notes: Resolved by `@koralabs/kora-labs-common` as:
#   `REDIS_HOST_${AWS_REGION}` (uppercased, dashes -> underscores) then `REDIS_HOST` then fallback.
#   Also used by `shell/local_valkey.sh` (default there is `127.0.0.1` when unset).
# Example: REDIS_HOST=valkey
REDIS_HOST=

# Required: no
# Default: empty
# Notes: Region-scoped override when `AWS_REGION` is set (example key for us-east-1 is `REDIS_HOST_US_EAST_1`).
# Example: REDIS_HOST_US_EAST_1=valkey.us-east-1.internal
REDIS_HOST_US_EAST_1=

# Required: no
# Default: true in worker when unset
# Example: REDIS_USE_TLS=false
REDIS_USE_TLS=

# Required: no
# Default: 6379 in worker, 6380 in `shell/local_valkey.sh`
# Notes: Port used by the Valkey worker (`workers/redisSync.worker.js`) and local test helper.
# Example: REDIS_PORT=6380
REDIS_PORT=

############################
# [CONTAINER] Container / Entrypoint Runtime
############################
# Required: no
# Default: all
# Values: api-only | ogmios | cardano-node | both | all
# Example: MODE=all
MODE=

# Required: no
# Default: false
# Example: DISABLE_NODE_SNAPSHOT=true
DISABLE_NODE_SNAPSHOT=

# Required: no
# Default: /db
# Example: NODE_DB=/mnt/efs/cardano/mainnet/db
NODE_DB=

# Required: no
# Default: /ipc/node.socket
# Example: SOCKET_PATH=/ipc/node.socket
SOCKET_PATH=

# Required: no
# Default: ./cardano-node
# Example: CARDANO_NODE_PATH=./cardano-node
CARDANO_NODE_PATH=

# Required: no
# Default: ./${NETWORK}
# Example: NODE_CONFIG_PATH=./mainnet
NODE_CONFIG_PATH=

# Required: no
# Default: false
# Example: ENABLE_SOCKET_REDIRECT=true
ENABLE_SOCKET_REDIRECT=

# Required: no
# Default: https://book.world.dev.cardano.org/environments
# Example: CONFIG_FILES_BASE_URL=https://book.world.dev.cardano.org/environments
CONFIG_FILES_BASE_URL=

############################
# [SCRIPT] Local Dev / Script Utilities
############################
# Required: no
# Default: from helper scripts
# Example: CARDANO_DB_PATH=./tmp
CARDANO_DB_PATH=

# Required: no
# Default: 1337 in `shell/start_local.sh`
# Example: OGMIOS_PORT=1337
OGMIOS_PORT=

# Required: no
# Default: 3000 in `shell/start_local.sh`
# Example: CARDANO_NODE_PORT=3000
CARDANO_NODE_PORT=

# Required: no
# Default: 6.11.2 in local/container install scripts
# Example: OGMIOS_VER=6.11.2
OGMIOS_VER=

# Required: no
# Default: 10.6.2 in `shell/start_local.sh`, 10.5.3 in `shell/install.sh`
# Example: CARDANO_NODE_VER=10.6.2
CARDANO_NODE_VER=

# Required: no
# Default: empty
# Notes: Used by local scripts that compare local results to live `api.handle.me`.
# Example: HANDLES_API_KEY=your_whitelisted_key
HANDLES_API_KEY=

# Required: no
# Default: 5000 in `scripts/logOgmiosRollbacks.ts`
# Example: OGMIOS_ROLLBACK_RECONNECT_MS=5000
OGMIOS_ROLLBACK_RECONNECT_MS=

# Required: no
# Default: empty
# Notes: `shell/reindex-scanner.sh` scans all `API_SCANNER_FUNCTION_URL_*` variables and can target one alias or `ALL`.
# Example: API_SCANNER_FUNCTION_URL_US_WEST_2_MAINNET=https://...lambda-url...
API_SCANNER_FUNCTION_URL_US_WEST_2_MAINNET=

# Required: no
# Default: https://api.handle.me when NETWORK=mainnet, otherwise https://${NETWORK}.api.handle.me
# Notes: Used by `scripts/verify-handles.ts` to choose the API host to verify against.
# Example: API_BASE=https://preview.api.handle.me
API_BASE=

# Required: no
# Default: Infinity (process every handle)
# Notes: Used by `scripts/verify-handles.ts` to cap the number of handles processed (for testing).
# Example: MAX_HANDLES=1000
MAX_HANDLES=

# Required: no
# Default: 0
# Notes: Used by `scripts/verify-handles.ts` to only check handles with `updated_slot_number >= this`.
# Example: START_SLOT=150000000
START_SLOT=

# Required: no
# Default: inherited from Node
# Example: NODE_OPTIONS=--max-old-space-size=12288
NODE_OPTIONS=

# Optional legacy/common runtime values currently exported but not directly consumed
SECRET_KEY=
LOG_FORMAT=
LOG_DIR=
