{
  "name": "handles-public-api",
  "version": "1.12.0",
  "description": "A downloadable and containerized decentralized API for Handles",
  "main": "index.js",
  "repository": "https://github.com/koralabs/handles-public-api.git",
  "author": "Papa Goose <papa.goose@koralabs.io>",
  "license": "Mozilla Public License 2.0",
  "type": "module",
  "module": "esnext",
  "scripts": {
    "stop:forever": "forever stop express.js",
    "start:forever": "mkdir -p forever && forever -p ./forever --minUptime 1 start express.js",
    "copy-dist-files": "mkdir -p dist && cp rollup.package.json dist/package.json && cp docs/swagger.yml dist/swagger.yml",
    "build:lambda": "npm run copy-dist-files && (cd dist && npm install) && npm exec -c 'rollup -c rollup.lambda.config.js'",
    "build:docker": "npm run build:production && docker build -t koralabs/handles-api .",
    "ogmios": "chmod +x ./shell/start_local.sh && ./shell/start_local.sh",
    "api": "tsx -r tsconfig-paths/register -r dotenv/config express.ts",
    "readonly": "READ_ONLY_STORE=true PORT=3142 tsx -r tsconfig-paths/register -r dotenv/config express.ts",
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "jest -c jest.config.ts --runInBand",
    "test:e2e": "chmod +x ./shell/local_valkey.sh && ./shell/local_valkey.sh && (export NETWORK=preview; jest -c jest.e2e.config.ts --forceExit --runInBand)",
    "lint": "ESLINT_USE_FLAT_CONFIG=false eslint --ext=.js,.ts --fix --max-warnings=0 ."
  },
  "dependencies": {
    "@cardano-ogmios/client": "^6.11.0",
    "@cardano-ogmios/schema": "^6.11.0",
    "@koralabs/kora-labs-common": "6.4.10",
    "@stricahq/cardano-codec": "^2.0.4",
    "@valkey/valkey-glide": "^2.0.1",
    "@vendia/serverless-express": "^4.12.6",
    "bech32": "^2.0.0",
    "cors": "^2.8.5",
    "cross-fetch": "^3.1.5",
    "express": "^4.18.1",
    "express-rate-limit": "^8.2.1",
    "fastq": "^1.19.1",
    "ioredis": "^5.4.2",
    "proper-lockfile": "^4.1.2",
    "swagger-ui-express": "^4.5.0",
    "yaml": "^2.5.0"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.964.0",
    "@rollup/plugin-commonjs": "^26.0.1",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-node-resolve": "^15.2.3",
    "@types/aws-lambda": "^8.10.148",
    "@types/cors": "^2.8.12",
    "@types/express": "^4.17.14",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.14.0",
    "@types/supertest": "^2.0.12",
    "@types/swagger-ui-express": "^4.1.3",
    "@types/ws": "^8.5.3",
    "@typescript-eslint/eslint-plugin": "^8.5.0",
    "@typescript-eslint/parser": "^8.5.0",
    "aws-sdk": "^2.1224.0",
    "dotenv": "^16.0.2",
    "forever": "^4.0.3",
    "jest": "^29.7.0",
    "prettier": "^2.7.1",
    "prettier-eslint": "^15.0.1",
    "prettier-eslint-cli": "^7.1.0",
    "rollup": "^4.21.1",
    "rollup-plugin-multi-input": "^1.5.0",
    "rollup-plugin-typescript2": "^0.36.0",
    "supertest": "^6.2.4",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.1.0",
    "tsx": "^4.17.0",
    "typescript": "^5.7.3"
  }
}
